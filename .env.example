# Plantilla de configuracion. Copia este fichero como .env y rellena los valores
# reales. El .env NO se sube a git (ver .gitignore); este ejemplo si, por eso
# aqui no puede haber ningun secreto.
#
# Lo lee Settings.GetSettings() (HomeService.Transversal.Common/Configuration),
# que busca el .env subiendo de directorio desde el binario. En produccion no
# hace falta el fichero: estas mismas variables se inyectan como variables de
# entorno del contenedor/servicio y tienen prioridad sobre el .env.

### Servidor ###
# Informativos mientras Program.cs no los use: Kestrel escucha lo que diga
# ASPNETCORE_URLS (por ejemplo http://0.0.0.0:5131).
APP_HOST=0.0.0.0
APP_PORT=5131

### Base de datos ###
# Cadena de conexion de Npgsql, no una URL estilo SQLAlchemy.
# Host=host;Port=puerto;Database=base_de_datos;Username=usuario;Password=password
DATABASE_URL=Host=localhost;Port=5432;Database=homelab_database;Username=postgres;Password=CAMBIAME

### Api ###
# Obligatoria: Settings lanza al arrancar si falta.
# Generar con: openssl rand -hex 32
# En PowerShell: -join (1..32 | % { '{0:x2}' -f (Get-Random -Maximum 256) })
INTERNAL_API_KEY=
# Bypass de la cabecera X-Debug-Key para pruebas manuales.
# Vacia = bypass desactivado (falla cerrado).
DEBUG_BYPASS_KEY=

### Alexa ###
ALEXA_VERSION=1.0
# Copiar de la consola de admin de Amazon
ALEXA_SKILL_ID=

### Gemini ###
# Copiar de Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

### iRobot / Roomba ###
ROOMBA_ID=
ROOMBA_PORT=8883
ROOMBA_BLID=
ROOMBA_PASSWD=
ROOMBA_PMAP_ID=
ROOMBA_PMAP_VERSION=

### Mqtt ###
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

### Ntfy (push al movil) ###
# Deja NTFY_TOPIC vacio para desactivar las notificaciones.
# Usa un nombre largo e impredecible: quien lo sepa puede leer tus avisos.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=

### Logging ###
# Settings no lo lee todavia; ASP.NET usa Logging__LogLevel__Default.
LOG_LEVEL=Information

### LanParameters ###
LAN_BROADCAST_IP=192.168.1.255
LAN_COMPUTER_IP=
LAN_COMPUTER_MAC=
LAN_CACHYOS_USER=
