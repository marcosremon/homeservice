# Plantilla de configuracion. Copia este fichero como .env y rellena los valores
# reales. El .env NO se sube a git (ver .gitignore); este ejemplo si, por eso
# aqui no puede haber ningun secreto.
#
# En produccion no hace falta .env: estas mismas variables se inyectan como
# variables de entorno del contenedor/servicio y tienen prioridad sobre el fichero.

### Servidor (equivalente al bloque Kestrel de appsettings.json) ###
APP_HOST=0.0.0.0
APP_PORT=5131

### Base de datos ###
# postgresql+asyncpg://usuario:password@host:puerto/base_de_datos
DATABASE_URL=postgresql+asyncpg://postgres:CAMBIAME@localhost:5432/homelab_database

### Api ###
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=
DEBUG_BYPASS_KEY=

### alexa ###
ALEXA_VERSION=1.0
# Copiar de la consola de admin de Amazon
ALEXA_SKILL_ID=

### Gemini ###
# Copiar de Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

### iRobot / roomba ###
ROOMBA_ID=
ROOMBA_PORT=8883
ROOMBA_BLID=
ROOMBA_PASSWD=
ROOMBA_PMAP_ID=
ROOMBA_PMAP_VERSION=

### Mqtt ###
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=

### LanParameters ###
LAN_BROADCAST_IP=192.168.1.255
LAN_COMPUTER_IP=
LAN_COMPUTER_MAC=
LAN_CACHYOS_USER=

### Logging ###
LOG_LEVEL=INFO