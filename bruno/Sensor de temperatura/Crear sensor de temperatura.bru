meta {
  name: Crear sensor de temperatura
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/sensors/temperature-sensor/create-temperature-sensor
  body: json
  auth: none
}

body:json {
  {
    "callOut": "cocina",
    "deviceName": "temperatura-cocina",
    "deviceType": "temperature_sensor",
    "model": "LM35",
    "manufacturer": "TI",
    "macAddress": "AA:00:00:00:00:01",
    "temperature": 21.5,
    "adcVoltage": 0.215,
    "measureAt": 1730000000
  }
}

docs {
  Todo obligatorio salvo la MAC. `temperature`, `adcVoltage` y `measureAt` a 0
  cuentan como no enviados (400). 409 si el dispositivo ya existe.
}
