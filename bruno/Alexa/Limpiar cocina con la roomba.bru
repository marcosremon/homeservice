  url: {{baseUrl}}/api/alexa
  body: json
  auth: none
}

body:json {
  {
    "version": "1.0",
    "request": {
      "type": "IntentRequest",
      "requestId": "bruno-roomba",
      "timestamp": "2026-10-30T10:00:00Z",
      "intent": {
        "name": "roomba_order_limpiar_cocina",
        "confirmationStatus": "NONE"
      }
    }
